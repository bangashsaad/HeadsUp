<.auth_shell title="Reset password" subtitle="The code from your email, plus your new password.">
  <.form :let={f} for={%{}} as={:user} action={~p"/reset-password"} class="space-y-4">
    <div :if={@error} class="rounded-lg border border-[#FF4557]/50 bg-[#FF4557]/10 px-3 py-2 text-sm text-[#FF4557]">
      {@error}
    </div>

    <label class="block">
      <span class="mb-1.5 block text-[11px] font-black uppercase tracking-[0.15em] text-[#8B91A7]">Email</span>
      <input
        type="email"
        name="user[email]"
        value={@email}
        required
        autocomplete="email"
        class="w-full rounded-xl border border-[#252A3A] bg-[#12141D] px-4 py-3 text-[#F4F5F7] outline-none focus:border-[#C8FF2E]/60"
      />
    </label>

    <label class="block">
      <span class="mb-1.5 block text-[11px] font-black uppercase tracking-[0.15em] text-[#8B91A7]">6-digit code</span>
      <input
        type="text"
        name="user[code]"
        inputmode="numeric"
        pattern="[0-9]{6}"
        maxlength="6"
        required
        placeholder="000000"
        class="w-full rounded-xl border border-[#252A3A] bg-[#12141D] px-4 py-3 text-center font-mono text-xl tracking-[0.5em] text-[#F4F5F7] outline-none focus:border-[#C8FF2E]/60"
      />
    </label>

    <label class="block">
      <span class="mb-1.5 block text-[11px] font-black uppercase tracking-[0.15em] text-[#8B91A7]">New password</span>
      <input
        type="password"
        name="user[password]"
        required
        minlength="8"
        autocomplete="new-password"
        placeholder="8+ characters"
        class="w-full rounded-xl border border-[#252A3A] bg-[#12141D] px-4 py-3 text-[#F4F5F7] outline-none focus:border-[#C8FF2E]/60"
      />
    </label>

    <button
      type="submit"
      class="w-full rounded-xl bg-[#C8FF2E] px-4 py-3.5 text-[15px] font-black uppercase tracking-wide text-[#0A0B10] transition hover:brightness-110"
    >
      Set the new password
    </button>
    <% _ = f %>
  </.form>

  <p class="mt-6 text-center text-sm text-[#8B91A7]">
    No code yet?
    <.link navigate={~p"/forgot-password"} class="font-bold text-[#C8FF2E] hover:underline">Send one</.link>
  </p>
</.auth_shell>
